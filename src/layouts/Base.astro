---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import FloatingCone from '../components/FloatingCone.astro';
import Cursor from '../components/Cursor.astro';
import { getLocale, locales, switchLocalePath, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Footer'daki büyük "Konuşalım" bloğu (iletişim ve 404'te kapalı) */
  footerCta?: boolean;
  /** Arama motorlarına kapalı (404) */
  noindex?: boolean;
}

const locale = getLocale(Astro.currentLocale);
const meta = t(locale).meta;
const { title = meta.title, description = meta.description, footerCta = true, noindex = false } = Astro.props;

// Statik build sayfaları klasör olarak üretir (/isler/), canonical ve hreflang sitemap ile aynı biçimde sonda / taşır
const site = Astro.site!;
const withSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const canonical = new URL(withSlash(Astro.url.pathname), site).href;
const alternates = locales.map((code) => ({
  code,
  href: new URL(withSlash(switchLocalePath(Astro.url.pathname, code)), site).href,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#005AFF" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ice Cream Hill" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.code} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    <!-- İlk boyamadan önce hareket ve preloader durumunu belirle (bkz. global.css) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = '1';
        try { seen = sessionStorage.getItem('ich:preloader'); } catch (e) {}
        d.dataset.motion = reduce ? 'off' : 'on';
        d.dataset.intro = reduce || seen ? 'off' : 'on';
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <Preloader />
    <Header />
    <main>
      <slot />
    </main>
    <Footer showCta={footerCta} />
    <FloatingCone />
    <Cursor />

    <script>
      import '../scripts/motion';
      import '../scripts/cursor';
    </script>
  </body>
</html>
