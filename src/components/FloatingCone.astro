---
import Cone from './Cone.astro';
---

<!--
  Sayfa geneli dondurma figürü (src/scripts/motion.ts):
  Sadece masaüstünde (768px ve üstü). Scroll ile tam sayfada 360° döner, bölümlere göre salınır.
  Gölge rengi altındaki bölümün data-theme değerine göre değişir; metin bloklarının üstünde
  soluklaşır (data-dim), [data-cone-hide] alanlarında gizlenir.
-->
<div
  class="float-cone pointer-events-none fixed right-8 bottom-[14svh] z-40 hidden w-[168px] transition-opacity duration-200 md:block"
  aria-hidden="true"
  data-float-cone
  data-glow="blue"
  transition:persist="float-cone"
>
  <Cone width={336} eager class="h-auto w-full" />
</div>
