---
import { Image } from 'astro:assets';
import dondurma from '../assets/dondurma.png';
import { getLocale, navRoutes, routePath, switchLocalePath, t } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale).header;
const pathname = Astro.url.pathname;

const nav = navRoutes.map((key) => {
  const href = routePath(key, locale);
  return { href, label: copy.nav[key], active: pathname.startsWith(href) };
});

const langs = (['tr', 'en'] as const).map((code) => ({
  code,
  href: switchLocalePath(pathname, code),
  active: code === locale,
}));

const homeHref = routePath('home', locale);
const contactHref = routePath('contact', locale);
---

<header class="sticky top-0 z-50 border-b border-ink bg-paper">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-6 px-5 md:h-[72px] md:px-10">
    <a href={homeHref} class="group flex items-center gap-3" aria-label="Ice Cream Hill">
      <Image
        src={dondurma}
        alt=""
        height={72}
        loading="eager"
        class="h-9 w-auto origin-bottom transition-transform duration-300 ease-out group-hover:rotate-[8deg] motion-reduce:transform-none"
      />
      <span class="flex items-baseline gap-3">
        <span class="type-display text-[22px] leading-none tracking-normal md:text-2xl">Ice Cream Hill</span>
        <span class="type-label hidden text-[10px] text-mute sm:inline" lang="en">{copy.tagline}</span>
      </span>
    </a>

    <nav class="hidden md:block" aria-label={copy.navLabel}>
      <ul class="flex items-center gap-9 text-sm font-bold">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['transition-colors hover:text-brand', item.active && 'text-brand']}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-5 md:gap-6">
      <div class="type-label flex items-center gap-2 text-[11px]" aria-label={copy.langLabel}>
        {langs.map((lang, i) => (
          <>
            {i > 0 && <span class="text-mute" aria-hidden="true">/</span>}
            <a
              href={lang.href}
              hreflang={lang.code}
              class:list={[lang.active ? 'text-ink' : 'text-mute hover:text-ink']}
              aria-current={lang.active ? 'true' : undefined}
            >
              {lang.code}
            </a>
          </>
        ))}
      </div>

      <a
        href={contactHref}
        class="hidden rounded-full bg-brand px-5 py-2.5 text-sm font-bold text-paper transition-colors hover:bg-brand-dark md:inline-block"
      >
        {copy.cta}
      </a>

      <button
        type="button"
        class="relative -mr-2 flex h-10 w-10 items-center justify-center md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={copy.menuOpen}
        data-menu-toggle
        data-label-open={copy.menuOpen}
        data-label-close={copy.menuClose}
      >
        <span class="menu-line absolute h-0.5 w-6 -translate-y-1 bg-ink transition-transform"></span>
        <span class="menu-line absolute h-0.5 w-6 translate-y-1 bg-ink transition-transform"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink bg-paper md:hidden" data-menu-panel>
    <nav class="px-5 pt-6 pb-8" aria-label={copy.mobileNavLabel}>
      <ul>
        {nav.map((item) => (
          <li class="border-b border-ink/15">
            <a
              href={item.href}
              class:list={['type-display block py-4 text-4xl', item.active && 'text-brand']}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={contactHref}
        class="mt-8 block rounded-full bg-brand py-4 text-center font-bold text-paper"
      >
        {copy.cta}
      </a>
    </nav>
  </div>
</header>

<style>
  [data-menu-toggle][aria-expanded='true'] .menu-line:first-child {
    transform: rotate(45deg);
  }
  [data-menu-toggle][aria-expanded='true'] .menu-line:last-child {
    transform: rotate(-45deg);
  }
</style>

<script>
  let controller: AbortController | undefined;

  function initMenu() {
    // Önceki sayfadan kalan global dinleyicileri temizle
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    if (!toggle || !panel) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      panel.classList.toggle('hidden', !open);
      document.documentElement.classList.toggle('overflow-hidden', open);
      if (open) window.lenis?.stop();
      else window.lenis?.start();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false), { signal });
    window
      .matchMedia('(min-width: 48rem)')
      .addEventListener('change', (e) => e.matches && setOpen(false), { signal });
  }

  // View Transitions ile her sayfa geçişinde yeniden bağla
  document.addEventListener('astro:page-load', initMenu);
</script>
