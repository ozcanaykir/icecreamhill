---
import Cone from '../Cone.astro';
import { getLocale, routePath, t } from '../../i18n';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale).pages.notFound;
---

<section class="bg-ink text-paper" data-theme="dark" data-cone-hide>
  <div class="mx-auto flex min-h-[calc(100svh-4rem)] max-w-[1440px] flex-col items-center justify-center px-5 py-20 text-center md:min-h-[calc(100svh-72px)] md:px-10">
    <Cone width={320} glow eager class="h-auto w-28 rotate-[-8deg] md:w-40" />
    <p class="type-label mt-10 text-brand-light">{copy.label}</p>
    <h1 class="type-display mt-4 text-[clamp(3.5rem,12vw,10rem)]">{copy.title}</h1>
    <p class="mt-6 max-w-md text-paper/75">{copy.body}</p>
    <a
      href={routePath('home', locale)}
      class="mt-10 inline-flex rounded-full bg-brand px-8 py-4 text-sm font-bold transition-colors hover:bg-brand-dark"
    >
      {copy.home}
    </a>
  </div>
</section>
