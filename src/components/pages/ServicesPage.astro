---
import CtaBand from '../CtaBand.astro';
import { getLocale, routePath, t } from '../../i18n';

const locale = getLocale(Astro.currentLocale);
const dict = t(locale);
const copy = dict.pages.services;
const services = dict.services;
const items = services.items.map((item, i) => ({ ...item, num: String(i + 1).padStart(2, '0') }));
---

<section class="mx-auto max-w-[1440px] px-5 pt-14 pb-10 md:px-10 md:pt-24 md:pb-16">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
    <div>
      <p class="type-label text-brand">{copy.label.replace('{n}', String(items.length))}</p>
      <h1 class="type-display mt-5 text-[clamp(3.5rem,11vw,10rem)]">{copy.title}</h1>
    </div>
    <p class="max-w-sm text-graphite lg:mb-3">{copy.lead}</p>
  </div>
</section>

<section class="mx-auto max-w-[1440px] px-5 pb-16 md:px-10 md:pb-24">
  <ol>
    {items.map((item) => (
      <li id={`hizmet-${item.num}`} class="grid scroll-mt-24 gap-5 border-t border-ink py-8 md:grid-cols-12 md:py-10" data-reveal>
        <span class="type-label text-brand md:col-span-1 md:pt-2">{item.num}</span>
        <h2 class="type-display text-[clamp(2rem,3.4vw,3.25rem)] md:col-span-5">{item.title}</h2>
        <div class="md:col-span-6">
          <p class="max-w-xl text-graphite md:text-lg">{item.body}</p>
          <dl class="mt-6 grid gap-6 sm:grid-cols-2">
            <div>
              <dt class="type-label text-[11px] text-mute">{copy.audienceLabel}</dt>
              <dd class="mt-2 text-sm font-bold">{services.audienceShort[item.audience as 'brands' | 'artists']}</dd>
            </div>
            <div>
              <dt class="type-label text-[11px] text-mute">{copy.deliverablesLabel}</dt>
              <dd class="mt-2">
                <ul class="space-y-1 text-sm">
                  {item.deliverables.map((d) => <li>{d}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </div>
      </li>
    ))}
  </ol>
  <div class="border-t border-ink"></div>
</section>

<section class="bg-ink text-paper">
  <div class="mx-auto max-w-[1440px] px-5 py-16 md:px-10 md:py-24">
    <div data-reveal>
      <p class="type-label text-brand-light">{copy.processLabel}</p>
      <h2 class="type-display mt-4 text-[clamp(3rem,7vw,6.5rem)]">{copy.processTitle}</h2>
    </div>
    <ol class="mt-12 grid gap-x-5 gap-y-10 sm:grid-cols-2 md:mt-16 lg:grid-cols-5" data-reveal>
      {services.steps.map((step, i) => (
        <li class="border-t border-paper pt-4">
          <span class="type-label block text-[11px] text-brand-light">{services.step} {i + 1}</span>
          <h3 class="type-display mt-3 text-[clamp(1.75rem,2.4vw,2.25rem)]">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-paper/75">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<CtaBand title={copy.ctaTitle} cta={copy.cta} href={routePath('contact', locale)} />
