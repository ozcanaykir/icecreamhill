---
import Cone from './Cone.astro';
import { getLocale, routePath, t } from '../i18n';
import { site } from '../site';

interface Props {
  /** İletişim sayfasında büyük "Konuşalım" bloğu tekrar etmesin */
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const copy = t(locale).footer;
const year = new Date().getFullYear();

// Başlığın sonundaki noktayı vurgu rengiyle ayır
const titleText = copy.title.replace(/\.$/, '');
const hasDot = titleText !== copy.title;
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-[1440px] px-5 pb-10 md:px-10">
    {showCta && (
      <div class="flex flex-col gap-10 pt-16 md:pt-24 lg:flex-row lg:items-end lg:justify-between" data-reveal>
        <div>
          <p class="type-label text-brand-light">{copy.label}</p>
          <a href={routePath('contact', locale)} class="group mt-6 flex items-end gap-[0.12em] type-display text-[clamp(3.5rem,15vw,11rem)]" data-footer-title>
            <span>{titleText}{hasDot && <span class="text-brand-light">.</span>}</span>
            <Cone
              width={240}
              glow
              class="mb-[0.06em] h-[0.62em] w-auto shrink-0 origin-top transition-transform duration-500 ease-out group-hover:scale-y-[1.08] motion-reduce:group-hover:scale-y-100"
              data-footer-cone
            />
          </a>
          <p class="mt-8 max-w-md text-paper/80 md:mt-10">{copy.lead}</p>
        </div>
        <a
          href={routePath('contact', locale)}
          class="inline-flex shrink-0 items-center justify-center rounded-full bg-brand px-10 py-5 text-base font-bold transition-colors hover:bg-brand-dark lg:mb-2"
        >
          {copy.cta}
        </a>
      </div>
    )}

    <div class:list={['type-label flex flex-col gap-4 text-[11px] md:flex-row md:items-center md:justify-between', showCta ? 'mt-16 border-t border-paper/15 pt-6 md:mt-24' : 'pt-8']}>
      <p class="text-mute">{copy.copyright.replace('{year}', String(year))}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href={site.instagram} target="_blank" rel="noopener" class="hover:text-brand-light">Instagram</a></li>
        <li><a href={site.youtube} target="_blank" rel="noopener" class="hover:text-brand-light">YouTube</a></li>
        <li><a href={`mailto:${site.email}`} class="normal-case hover:text-brand-light">{site.email}</a></li>
      </ul>
    </div>
  </div>
</footer>
