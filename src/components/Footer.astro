---
import { Image } from 'astro:assets';
import dondurma from '../assets/dondurma.png';
import { getLocale, routePath, t } from '../i18n';
import { site } from '../site';

const locale = getLocale(Astro.currentLocale);
const copy = t(locale).footer;
const year = new Date().getFullYear();

// Başlığın sonundaki noktayı vurgu rengiyle ayır
const titleText = copy.title.replace(/\.$/, '');
const hasDot = titleText !== copy.title;

const fieldClass =
  'w-full border border-paper/20 bg-transparent px-4 py-3 text-sm text-paper placeholder:text-mute focus:border-brand-light focus:outline-none';
---

<footer id="iletisim" class="bg-ink text-paper">
  <div class="mx-auto max-w-[1440px] px-5 pt-16 pb-10 md:px-10 md:pt-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_minmax(0,420px)] lg:gap-16 xl:grid-cols-[1fr_minmax(0,520px)]">
      <div>
        <p class="type-label text-brand-light">{copy.label}</p>
        <h2 class="group type-display mt-6 flex items-end gap-[0.12em] text-[clamp(3.5rem,14vw,8rem)] lg:text-[clamp(5rem,8.4vw,8.5rem)]">
          <span>{titleText}{hasDot && <span class="text-brand-light">.</span>}</span>
          <Image
            src={dondurma}
            alt=""
            height={200}
            class="mb-[0.06em] h-[0.62em] w-auto shrink-0 origin-top transition-transform duration-500 ease-out group-hover:scale-y-[1.08] motion-reduce:transform-none"
          />
        </h2>
        <p class="mt-8 max-w-md text-paper/80 md:mt-10">{copy.lead}</p>

        <a
          href={routePath('contact', locale)}
          class="mt-8 block rounded-full bg-brand py-4 text-center font-bold transition-colors hover:bg-brand-dark lg:hidden"
        >
          {copy.cta}
        </a>
      </div>

      <form class="hidden flex-col gap-6 lg:flex" data-contact-form>
        <label class="flex flex-col gap-2">
          <span class="type-label text-[11px] text-paper/70">{copy.form.name}</span>
          <input class={fieldClass} type="text" name="name" autocomplete="name" required placeholder={copy.form.namePlaceholder} />
        </label>
        <label class="flex flex-col gap-2">
          <span class="type-label text-[11px] text-paper/70">{copy.form.brand}</span>
          <input class={fieldClass} type="text" name="brand" autocomplete="organization" placeholder={copy.form.brandPlaceholder} />
        </label>
        <label class="flex flex-col gap-2">
          <span class="type-label text-[11px] text-paper/70">{copy.form.message}</span>
          <textarea class:list={[fieldClass, 'min-h-36 resize-y']} name="message" rows="5" required placeholder={copy.form.messagePlaceholder}></textarea>
        </label>
        <button
          type="submit"
          class="rounded-full bg-brand py-4 text-sm font-bold transition-colors hover:bg-brand-dark"
        >
          {copy.form.submit}
        </button>
      </form>
    </div>

    <div class="type-label mt-16 flex flex-col gap-4 border-t border-paper/15 pt-6 text-[11px] md:mt-24 md:flex-row md:items-center md:justify-between">
      <p class="text-mute">{copy.copyright.replace('{year}', String(year))}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <li><a href={site.instagram} target="_blank" rel="noopener" class="hover:text-brand-light">Instagram</a></li>
        <li><a href={site.youtube} target="_blank" rel="noopener" class="hover:text-brand-light">YouTube</a></li>
        <li><a href={`mailto:${site.email}`} class="normal-case hover:text-brand-light">{site.email}</a></li>
      </ul>
      <p class="text-mute">{copy.cities}</p>
    </div>
  </div>
</footer>
