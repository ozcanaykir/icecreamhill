---
interface Props {
  title: string;
  cta: string;
  href: string;
}

const { title, cta, href } = Astro.props;
---

<section class="bg-brand text-paper">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-8 px-5 py-14 md:flex-row md:items-center md:justify-between md:px-10 md:py-20" data-reveal>
    <h2 class="type-display text-[clamp(2.75rem,6.5vw,6rem)]">{title}</h2>
    <a
      href={href}
      class="inline-flex shrink-0 items-center justify-center self-start rounded-full bg-ink px-8 py-4 text-sm font-bold transition-colors hover:bg-paper hover:text-ink md:self-auto"
    >
      {cta}
    </a>
  </div>
</section>
