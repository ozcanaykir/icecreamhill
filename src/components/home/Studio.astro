---
import { Image } from 'astro:assets';
import logo from '../../assets/logo-seffaf.png';
import portrait from '../../assets/projeler/recrum-artist-serisi/galeri-1.jpg';
import { t } from '../../i18n';

const copy = t(Astro.currentLocale).home.studio;
---

<section class="mx-auto max-w-[1440px] px-5 py-16 md:px-10 md:py-28">
  <div class="grid items-center gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5" data-reveal>
      <p class="type-label text-brand">{copy.label}</p>
      <h2 class="type-display mt-4 text-[clamp(3rem,6vw,5.5rem)] leading-[1]">{copy.title}</h2>
      <p class="mt-6 max-w-md text-graphite">{copy.body}</p>

      <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-6">
        {copy.stats.map((stat) => (
          <div class="flex flex-col-reverse">
            <dt class="type-label mt-2 text-[10px] text-mute">{stat.label}</dt>
            <dd class="type-display text-[clamp(2.5rem,4vw,3.5rem)] text-brand">{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="grid grid-cols-2 gap-3 md:col-span-7 md:gap-5" data-reveal>
      <div class="relative flex aspect-[5/6] items-center justify-center overflow-hidden bg-brand p-[12%]">
        <Image src={logo} alt={copy.logoAlt} widths={[320, 600]} sizes="(min-width: 768px) 28vw, 45vw" class="h-auto w-full" />
      </div>
      <div class="relative aspect-[5/6] overflow-hidden bg-paper">
        <Image
          src={portrait}
          alt={copy.imageAlt}
          widths={[400, 700, 960]}
          sizes="(min-width: 768px) 28vw, 45vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
