---
import { getImage } from 'astro:assets';
import Cone from '../Cone.astro';
import posterSrc from '../../assets/projeler/kirmizi-fon-kampanyasi/kapak.jpg';
import { t } from '../../i18n';
import { showreel } from '../../site';

const copy = t(Astro.currentLocale).home.hero;
const poster = await getImage({ src: posterSrc, width: 1800, format: 'webp' });
const hasVideo = Boolean(showreel.src);

// Video varsa tam ekran oynatan buton, yoksa seçili işlere giden link
const Cta = hasVideo ? 'button' : 'a';
const ctaProps = hasVideo ? { type: 'button', 'data-showreel-play': '' } : { href: '#secili-isler' };
---

<section class="relative isolate flex min-h-[calc(100svh-4rem)] flex-col overflow-hidden bg-ink text-paper md:min-h-[calc(100svh-72px)]">
  <video
    class="absolute inset-0 -z-20 h-full w-full object-cover"
    poster={poster.src}
    autoplay={hasVideo}
    muted
    loop
    playsinline
    preload={hasVideo ? 'metadata' : 'none'}
    aria-hidden="true"
    data-hero-video
  >
    {hasVideo && <source src={showreel.src} type={showreel.type} />}
  </video>
  <!-- Okunabilirlik için düz karartma + alt kenarda koyulaşma -->
  <div class="absolute inset-0 -z-10 bg-ink/35"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-linear-to-t from-ink/80 to-transparent"></div>

  <div class="type-label relative flex justify-between px-5 pt-5 text-[11px] md:px-10 md:pt-6">
    <span>{copy.eyebrow}</span>
    <span class="hidden sm:inline">{copy.location}</span>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-end px-5 pb-8 md:px-10 md:pb-10">
    <h1 class="type-display text-[clamp(4rem,min(21vw,24svh),14rem)] leading-[0.88]">
      {copy.title.map((line) => (
        <span class="-mt-[0.24em] block overflow-hidden pt-[0.24em] pb-[0.02em]">
          <span class:list={['block', line.accent && 'text-brand']} data-hero-line>
            {line.text}
          </span>
        </span>
      ))}
    </h1>

    <div class="mt-8 flex flex-col gap-6 md:mt-10 md:flex-row md:items-end md:justify-between">
      <p class="max-w-md text-sm leading-relaxed text-paper/85 md:text-base" data-hero-fade>{copy.lead}</p>

      <Cta
        {...ctaProps}
        class="inline-flex cursor-pointer items-center justify-center gap-3 rounded-full bg-brand px-7 py-4 text-sm font-bold transition-colors hover:bg-brand-dark"
        data-hero-fade
      >
        <span class="h-2 w-2 rounded-full bg-paper" aria-hidden="true"></span>
        {copy.cta}
      </Cta>
    </div>
  </div>

  <!-- Dondurma figürü: scroll ile yukarı kayar ve döner (motion.ts / parallax) -->
  <div
    class="pointer-events-none absolute top-[18%] right-3 w-[120px] sm:w-[160px] md:top-auto md:right-[6%] md:bottom-[22%] md:w-[234px]"
    aria-hidden="true"
    data-parallax
    data-parallax-y="-40"
    data-parallax-rotate="10"
  >
    <Cone width={468} glow eager class="h-auto w-full" />
  </div>
</section>

<script>
  function initHero() {
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!video) return;

    // Hareket azaltma açıkken arka plan videosu oynamaz
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
    }

    // Showreel: videoyu sesli ve tam ekran aç
    const play = document.querySelector<HTMLElement>('[data-showreel-play]');
    const open = () => {
      video.muted = false;
      video.controls = true;
      video.currentTime = 0;
      video.play();
      video.requestFullscreen?.();
    };
    play?.addEventListener('click', open);
    video.addEventListener('fullscreenchange', () => {
      if (document.fullscreenElement) return;
      video.muted = true;
      video.controls = false;
    });
  }

  document.addEventListener('astro:page-load', initHero);
</script>
