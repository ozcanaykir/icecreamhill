---
import { Image } from 'astro:assets';
import kolaj from '../../assets/hero/la-esperanza-kolaj.jpg';
import supercoffDisMekan from '../../assets/projeler/supercoff-berlin/dis-mekan.jpg';
import kirmiziFon from '../../assets/projeler/kirmizi-fon-kampanyasi/kapak.jpg';
import badBegs from '../../assets/projeler/bad-begs-zeit/kapak.jpg';
import { t } from '../../i18n';
import { showreel } from '../../site';

const copy = t(Astro.currentLocale).home.hero;
const hasVideo = Boolean(showreel.loop);
const hasFull = Boolean(showreel.full);

// Video yoksa ya da oynatılamazsa arka planda sırayla dönen görseller
const slides = [
  { src: kolaj, position: 'center' },
  { src: supercoffDisMekan, position: 'center 35%' },
  { src: kirmiziFon, position: 'center' },
  { src: badBegs, position: 'center 30%' },
];
const pad = (n: number) => String(n).padStart(2, '0');

// Sesli showreel varsa modal açan buton, yoksa seçili işlere giden link
const Cta = hasFull ? 'button' : 'a';
const ctaProps = hasFull ? { type: 'button', 'data-showreel-open': '' } : { href: '#secili-isler' };
---

<section
  class="relative isolate flex min-h-[calc(100svh-4rem)] flex-col overflow-hidden bg-ink text-paper md:min-h-[calc(100svh-72px)]"
  data-theme="dark"
  data-hero
>
  <!--
    Arka plan. Mobilde 4:5 videonun doğal oranına yakın üstte bir kutu (altı siyaha karışır),
    masaüstünde tüm alanı kaplar (object-cover, ortalı). Poster'daki film karesi kenarı görünmesin diye %4 büyütülür.
  -->
  <div class="absolute inset-x-0 top-0 -z-20 aspect-[4/5] overflow-hidden md:inset-0 md:aspect-auto" aria-hidden="true">
    {hasVideo && (
      <>
        <video
          class="absolute inset-0 h-full w-full scale-[1.04] object-cover"
          poster={showreel.poster}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          data-hero-video
        >
          <source src={showreel.loop} type={showreel.type} data-hero-video-source />
        </video>
        <!-- Hareket azaltma açıkken video yerine (global.css: html[data-motion="off"]) -->
        <img src={showreel.poster} alt="" class="absolute inset-0 hidden h-full w-full scale-[1.04] object-cover" data-hero-poster />
      </>
    )}

    <div class="absolute inset-0" hidden={hasVideo} data-hero-slider>
      {slides.map((slide, i) => (
        <div class:list={['absolute inset-0 overflow-hidden', i > 0 && 'opacity-0']} data-hero-slide>
          <Image
            src={slide.src}
            alt=""
            widths={[800, 1400, 2000]}
            sizes="100vw"
            loading={i === 0 && !hasVideo ? 'eager' : 'lazy'}
            fetchpriority={i === 0 && !hasVideo ? 'high' : 'auto'}
            class="h-full w-full object-cover will-change-transform"
            style={`object-position: ${slide.position}`}
          />
        </div>
      ))}
    </div>

    <!-- Mobil: kutunun alt kenarı siyah zemine karışır -->
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-ink to-transparent md:hidden"></div>
  </div>

  <!-- Okunabilirlik: düz karartma, üst etiketler için üstten, başlık için alttan koyulaşma -->
  <div class="absolute inset-0 -z-10 bg-ink/30"></div>
  <div class="absolute inset-x-0 top-0 -z-10 h-36 bg-linear-to-b from-ink/70 to-transparent"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-linear-to-t from-ink/85 to-transparent"></div>

  <div class="type-label relative flex justify-between px-5 pt-5 text-[11px] md:px-10 md:pt-6">
    <span>{copy.eyebrow}</span>
    <span class="hidden sm:inline">{copy.location}</span>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-end px-5 pb-14 md:px-10 md:pb-16">
    <h1 class="type-display text-[56px] leading-[0.92] md:text-[clamp(64px,7.8vw,120px)]">
      {copy.title.map((line) => (
        <span class="-mt-[0.24em] block overflow-hidden pt-[0.24em] pb-[0.02em]">
          <span class="block" data-hero-line>
            {line.map((seg) => (
              <span class:list={['accent' in seg && seg.accent && 'text-brand']}>{seg.text}</span>
            ))}
          </span>
        </span>
      ))}
    </h1>

    <div class="mt-8 flex flex-col gap-6 md:mt-10 md:flex-row md:items-end md:justify-between">
      <p class="max-w-md text-sm leading-relaxed text-paper/85 md:text-base" data-hero-fade>{copy.lead}</p>

      <Cta
        {...ctaProps}
        class="inline-flex cursor-pointer items-center justify-center gap-3 rounded-full bg-brand px-7 py-4 text-sm font-bold transition-colors hover:bg-brand-dark"
        data-hero-fade
      >
        <span class="h-2 w-2 rounded-full bg-paper" aria-hidden="true"></span>
        {copy.cta}
      </Cta>
    </div>
  </div>

  <p
    class="type-label absolute right-5 bottom-4 z-10 text-[11px] text-paper/80 md:right-10 md:bottom-5"
    aria-hidden="true"
    hidden={hasVideo}
    data-hero-counter-wrap
  >
    <span data-hero-counter>01</span> / {pad(slides.length)}
  </p>
</section>

{hasFull && (
  <dialog
    class="showreel-dialog m-0 h-dvh max-h-none w-screen max-w-none bg-ink p-0 text-paper backdrop:bg-ink"
    aria-label={copy.dialogLabel}
    data-showreel-dialog
  >
    <div class="flex h-full w-full items-center justify-center p-4 md:p-10" data-showreel-backdrop>
      <video
        class="aspect-[4/5] max-h-full max-w-full bg-ink object-contain"
        src={showreel.full}
        poster={showreel.poster}
        controls
        playsinline
        preload="none"
        data-showreel-full
      ></video>
    </div>
    <button
      type="button"
      class="type-label absolute top-4 right-4 flex items-center gap-3 rounded-full border border-paper/40 bg-ink/60 px-4 py-2.5 text-[11px] transition-colors hover:bg-paper hover:text-ink md:top-6 md:right-6"
      data-showreel-close
    >
      {copy.close}
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
        <path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </dialog>
)}

<script>
  import { gsap } from 'gsap';

  const SLIDE_SECONDS = 5;
  const FADE_SECONDS = 1.2;
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let cleanup: (() => void)[] = [];
  const onCleanup = (fn: () => void) => cleanup.push(fn);

  /* ------------------------------------------------------------ Slider (yedek) */

  function startSlider() {
    const slides = gsap.utils.toArray<HTMLElement>('[data-hero-slide]');
    const counter = document.querySelector<HTMLElement>('[data-hero-counter]');
    if (slides.length < 2 || reduceMotion()) return;

    const imgs = slides.map((s) => s.querySelector('img'));
    let current = 0;
    let timer: gsap.core.Tween;

    // Ken Burns: gösterim + geçiş süresince 1.0 -> 1.06
    const kenBurns = (i: number) =>
      gsap.fromTo(imgs[i], { scale: 1 }, { scale: 1.06, duration: SLIDE_SECONDS + FADE_SECONDS, ease: 'none' });

    // Her 5 sn'de bir sonraki görsel üstte belirir (crossfade), alttaki gizlenir
    const advance = () => {
      const prev = current;
      current = (current + 1) % slides.length;
      gsap.set(slides[prev], { zIndex: 1 });
      gsap.set(slides[current], { zIndex: 2 });
      kenBurns(current);
      gsap.fromTo(
        slides[current],
        { autoAlpha: 0 },
        {
          autoAlpha: 1,
          duration: FADE_SECONDS,
          ease: 'power1.inOut',
          onComplete: () => gsap.set(slides[prev], { autoAlpha: 0, zIndex: 0 }),
        },
      );
      if (counter) counter.textContent = String(current + 1).padStart(2, '0');
      timer = gsap.delayedCall(SLIDE_SECONDS, advance);
    };

    gsap.set(slides, { autoAlpha: 0, zIndex: 0 });
    gsap.set(slides[0], { autoAlpha: 1, zIndex: 1 });
    kenBurns(0);
    timer = gsap.delayedCall(SLIDE_SECONDS, advance);

    onCleanup(() => {
      timer.kill();
      gsap.killTweensOf([...slides, ...imgs]);
    });
  }

  /** Video yoksa veya oynatılamazsa: videoyu gizle, slider'ı ve sayacı göster */
  function fallbackToSlider() {
    const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
    if (!slider || !slider.hidden) return;
    document.querySelector<HTMLVideoElement>('[data-hero-video]')?.setAttribute('hidden', '');
    slider.hidden = false;
    const counter = document.querySelector<HTMLElement>('[data-hero-counter-wrap]');
    if (counter) counter.hidden = false;
    startSlider();
  }

  /* ------------------------------------------------------------ Arka plan videosu */

  function initVideo() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!hero) return;
    const noop = { onOpen: () => {}, onClose: () => {} };
    if (!video) {
      // Loop videosu tanımlı değil: slider zaten görünür
      startSlider();
      initShowreelDialog(noop);
      return;
    }

    // Hareket azaltma: arka plan videosu hiç oynamaz, yerine poster (CSS html[data-motion="off"] ile de gizli).
    // Sesli showreel kullanıcı isteğiyle açıldığı için modal yine çalışır.
    if (reduceMotion()) {
      video.pause();
      video.removeAttribute('autoplay');
      video.preload = 'none';
      initShowreelDialog(noop);
      return;
    }

    let inView = true;
    let modalOpen = false;

    const play = () => {
      if (!inView || modalOpen || video.hidden) return;
      video.play().catch((err: DOMException) => {
        // Pause ile kesilen play() (AbortError) normal; diğerleri (autoplay engeli vb.) slider'a düşer
        if (err.name !== 'AbortError') fallbackToSlider();
      });
    };

    // Kaynak yüklenemezse (404, desteklenmeyen format) slider'a düş
    const source = video.querySelector('[data-hero-video-source]');
    source?.addEventListener('error', fallbackToSlider);
    video.addEventListener('error', fallbackToSlider);
    if (video.error || video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) fallbackToSlider();

    // Sadece hero görünürken oynat
    const io = new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) play();
        else video.pause();
      },
      { threshold: 0.05 },
    );
    io.observe(hero);
    onCleanup(() => io.disconnect());

    initShowreelDialog({
      onOpen: () => {
        modalOpen = true;
        video.pause();
      },
      onClose: () => {
        modalOpen = false;
        play();
      },
    });
  }

  /* ------------------------------------------------------------ Sesli showreel modal'ı */

  function initShowreelDialog(hooks: { onOpen: () => void; onClose: () => void }) {
    const dialog = document.querySelector<HTMLDialogElement>('[data-showreel-dialog]');
    const full = dialog?.querySelector<HTMLVideoElement>('[data-showreel-full]');
    const openBtn = document.querySelector<HTMLElement>('[data-showreel-open]');
    if (!dialog || !full || !openBtn) return;

    const open = () => {
      hooks.onOpen();
      window.lenis?.stop();
      dialog.showModal();
      full.currentTime = 0;
      full.muted = false;
      full.play().catch(() => {
        /* tarayıcı sesli oynatmayı engellerse kontroller görünür, kullanıcı başlatır */
      });
    };

    openBtn.addEventListener('click', open);
    dialog.querySelector('[data-showreel-close]')?.addEventListener('click', () => dialog.close());
    // Videonun dışındaki siyah alana tıklayınca kapanır; Esc tarayıcı tarafından kapatılır
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || e.target === dialog.querySelector('[data-showreel-backdrop]')) dialog.close();
    });
    dialog.addEventListener('close', () => {
      full.pause();
      window.lenis?.start();
      hooks.onClose();
    });
    onCleanup(() => dialog.open && dialog.close());
  }

  document.addEventListener('astro:page-load', () => {
    cleanup.forEach((fn) => fn());
    cleanup = [];
    initVideo();
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup.forEach((fn) => fn());
    cleanup = [];
  });
</script>
