---
import { getLocale, routePath, t } from '../../i18n';

const locale = getLocale(Astro.currentLocale);
const dict = t(locale);
const copy = dict.home.services;
const services = dict.services;

// Hizmetler tek kaynaktan (i18n services.items), kitleye göre iki sütun. 01-08 numaralar sütunlar boyunca devam eder.
const numbered = services.items.map((item, i) => ({ ...item, num: String(i + 1).padStart(2, '0') }));
const groups = (['brands', 'artists'] as const).map((audience) => ({
  title: services.audiences[audience],
  items: numbered.filter((item) => item.audience === audience).map((item) => ({ label: item.title, num: item.num })),
}));
const steps = services.steps.map((step) => step.title);
const servicesHref = routePath('services', locale);
---

<section class="bg-brand text-paper">
  <div class="mx-auto max-w-[1440px] px-5 py-16 md:px-10 md:py-24">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="type-label text-paper/80">{copy.label}</p>
        <h2 class="type-display mt-4 text-[clamp(3rem,7vw,6.5rem)]">{copy.title}</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-paper/90 md:text-base">{copy.lead}</p>
    </div>

    <div class="mt-12 grid gap-10 md:mt-16 md:grid-cols-2 md:gap-5">
      {groups.map((group) => (
        <div data-reveal>
          <h3 class="type-label border-t border-paper/70 pt-3 text-[11px] text-paper/80">{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li class="flex items-start justify-between gap-4 border-b border-paper/30 py-3 md:py-4">
                <a href={`${servicesHref}#hizmet-${item.num}`} class="type-display text-[clamp(1.375rem,2.4vw,2.25rem)] transition-opacity hover:opacity-70">{item.label}</a>
                <span class="type-label pt-1 text-[10px] text-paper/80">{item.num}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 md:mt-20" data-reveal>
      <h3 class="sr-only">{copy.stepsLabel}</h3>
      <ol class="grid grid-cols-2 gap-x-5 gap-y-6 sm:grid-cols-3 md:grid-cols-5">
        {steps.map((step, i) => (
          <li class="border-t border-paper pt-3">
            <span class="type-label block text-[10px] text-paper/80">{services.step} {i + 1}</span>
            <span class="mt-1 block text-sm font-bold">{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
